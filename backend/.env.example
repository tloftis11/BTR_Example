# Copy this file to .env and fill in values before running locally

# PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/biothreat

# Optional: CDC Socrata app token (raises API rate limits)
# Get one free at https://data.cdc.gov/login → Developer Settings
SOCRATA_APP_TOKEN=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173"]
